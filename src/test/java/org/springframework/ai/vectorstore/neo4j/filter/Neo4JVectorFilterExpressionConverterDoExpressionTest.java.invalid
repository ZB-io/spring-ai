	@Test
	@Tag("valid")
	void ninExpressionConvertsToNotInExpression() {
		// Arrange
		Key leftOperand = new Key("property");
		List<String> rightOperand = Arrays.asList("value1", "value2");
		Expression ninExpression = new Expression(ExpressionType.NIN, leftOperand, rightOperand);
		// Act
		this.converter.doExpression(ninExpression, this.context);
		// Assert
		verify(this.converter, times(1)).doNot(argThat(expr ->
			expr.type() == ExpressionType.NOT &&
			expr.left() instanceof Expression &&
			((Expression) expr.left()).type() == ExpressionType.IN &&
			((Expression) expr.left()).left().equals(leftOperand) &&
			((Expression) expr.left()).right().equals(rightOperand)
		), eq(this.context));
		verify(this.converter, never()).convertOperand(any(), any());
		verify(this.converter, never()).getOperationSymbol(any());
	}
