import org.springframework.retry.RetryContext;
import org.springframework.retry.support.RetryTemplate;
import org.springframework.util.CollectionUtils;
import org.springframework.util.StreamUtils;
import org.springframework.web.client.ResponseErrorHandler;

class SpringAiRetryAutoConfigurationRetryTemplateTest {
    @Mock
    private SpringAiRetryProperties mockProperties;
    @Mock
    private Backoff mockBackoff;
    private SpringAiRetryAutoConfiguration retryAutoConfiguration;
    @BeforeEach
    void setUp() {
        MockitoAnnotations.openMocks(this);
        retryAutoConfiguration = new SpringAiRetryAutoConfiguration();
    }
    @Test
    @Tag("valid")
    public void verifyRetryTemplateConfigurationWithValidProperties() {
        // Arrange
        when(mockProperties.getMaxAttempts()).thenReturn(5);
        when(mockProperties.getBackoff()).thenReturn(mockBackoff);
        when(mockBackoff.getInitialInterval()).thenReturn(1000L);
        when(mockBackoff.getMultiplier()).thenReturn(2.0);
        when(mockBackoff.getMaxInterval()).thenReturn(10000L);
        // Act
        RetryTemplate retryTemplate = retryAutoConfiguration.retryTemplate(mockProperties);
        // Assert
        RetryTemplateBuilder builder = RetryTemplate.builder()
                .maxAttempts(5)
                .retryOn(TransientAiException.class)
                .retryOn(ResourceAccessException.class)
                .exponentialBackoff(1000L, 2.0, 10000L)
                .withListener(any(RetryListener.class));
        RetryTemplate expectedTemplate = builder.build();
        assertEquals(expectedTemplate.toString(), retryTemplate.toString());
    }
}